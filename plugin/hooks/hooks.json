{
	"modules": ["./switchboard.ts"],
	"hooks": {
		"PermissionRequest": [
			{
				"matcher": "^mcp__switchboard__",
				"hooks": [
					{
						"type": "command",
						"command": "printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "^(?!mcp__switchboard__)",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/permission-request.sh\"",
						"timeout": 86400
					}
				]
			}
		]
	}
}
